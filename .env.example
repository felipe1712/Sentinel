# Base de datos PostGIS
DATABASE_URL=postgresql://urbanwatch:urbanwatch_pass_2026@localhost:5433/urbanwatch_db
DB_PASSWORD=urbanwatch_pass_2026

# Redis
REDIS_URL=redis://localhost:6380/1

# Claude API (Clasificación de incidentes + Resúmenes Ejecutivos)
ANTHROPIC_API_KEY=sk-ant-...

# E-Medios (login con usuario/contraseña)
EMEDIOS_BASE_URL=https://www.e-medios.com
EMEDIOS_USER=tu_usuario@dominio.com
EMEDIOS_PASS=tu_password

# Lightpanda (batch scraping E-Medios, alto volumen, ~120MB RAM)
LIGHTPANDA_CDP_URL=ws://localhost:9222

# HeadlessX (Camoufox anti-detección para dark web y foros)
HEADLESSX_URL=http://localhost:38473
HEADLESSX_API_KEY=hx_urbanwatch_key_2026

# PixelRAG (monitoreo visual de sitios en la mira, umbral >15%)
PIXELRAG_INDEX_DIR=/data/pixelrag_indexes

# WorldMonitor MCP (inteligencia global, máx 3-5 llamadas por análisis)
WORLDMONITOR_KEY=wm_...

# IntelligenceX (dark web indexada)
INTELX_API_KEY=

# Tor proxy (para onion sites via HeadlessX)
TOR_PROXY=socks5://127.0.0.1:9050

# Almacenamiento
DOCUMENTS_PATH=/data/documents
CAPTURES_PATH=/data/captures
