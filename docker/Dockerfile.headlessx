FROM python:3.11-slim

WORKDIR /app

RUN pip install --no-cache-dir fastapi==0.115.0 uvicorn[standard]==0.30.6 httpx[socks]==0.27.2 beautifulsoup4==4.12.3

COPY headlessx_server.py /app/headlessx_server.py

EXPOSE 38473

CMD ["uvicorn", "headlessx_server:app", "--host", "0.0.0.0", "--port", "38473"]
